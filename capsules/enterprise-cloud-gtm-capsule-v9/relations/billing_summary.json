{
  "relation_id": "billing_summary",
  "inputs": {
    "invoices": "data/invoices.csv"
  },
  "steps": [
    {
      "id": "summary",
      "op": "aggregate",
      "from": "invoices",
      "group_by": [],
      "measures": [
        {
          "name": "revenue",
          "function": "SUM",
          "column": "gross_amount"
        },
        {
          "name": "reconciled_amount",
          "function": "SUM",
          "column": "reconciled_amount"
        },
        {
          "name": "outstanding",
          "function": "SUM",
          "column": "outstanding_amount"
        },
        {
          "name": "invoice_count",
          "function": "COUNT",
          "column": "invoice_id"
        }
      ]
    }
  ],
  "output": "summary"
}
