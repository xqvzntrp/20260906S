{
  "relation_id": "product_usage",
  "inputs": {
    "contract_lines": "data/contract_line_items.csv",
    "usage": "data/usage_events.csv",
    "products": "data/products.csv"
  },
  "steps": [
    {
      "id": "usage_with_contract",
      "op": "join",
      "left": "contract_lines",
      "right": "usage",
      "on": [
        {
          "left": "contract_line_id",
          "operator": "=",
          "right": "contract_line_id"
        }
      ]
    },
    {
      "id": "usage_with_product",
      "op": "join",
      "left": "usage_with_contract",
      "right": "products",
      "on": [
        {
          "left": "product_id",
          "operator": "=",
          "right": "product_id"
        }
      ]
    },
    {
      "id": "summary",
      "op": "aggregate",
      "from": "usage_with_product",
      "group_by": [
        "product_name",
        "product_family"
      ],
      "measures": [
        {
          "name": "consumed_quantity",
          "function": "SUM",
          "column": "quantity"
        },
        {
          "name": "usage_event_count",
          "function": "COUNT",
          "column": "usage_event_id"
        }
      ]
    }
  ],
  "output": "summary"
}
