{
  "relation_id": "partner_product_authorized_exposure",
  "description": "Attributed product booking exposure with matching partner commercial authorization evidence. Authorization remains independent from Expertise, attribution type, compensation, and commercial route.",
  "inputs": {
    "exposure": "partner_product_booking_exposure",
    "authorization": "data/partner_commercial_authorizations.csv"
  },
  "steps": [
    {
      "id": "with_authorization",
      "op": "join",
      "left": "exposure",
      "right": "authorization",
      "on": [
        {
          "left": "partner_registry_id",
          "operator": "=",
          "right": "partner_registry_id"
        },
        {
          "left": "product_name",
          "operator": "=",
          "right": "product_name"
        }
      ]
    },
    {
      "id": "selected",
      "op": "project",
      "from": "with_authorization",
      "select": [
        "principal_partner_registry_id",
        "partner_registry_id",
        "partner_name",
        "membership_type",
        "attribution_type",
        "product_name",
        "authorization_id",
        "commercial_motion",
        "regional_market",
        "authorization_status",
        "effective_date",
        "booking_exposure",
        "opportunity_count"
      ]
    }
  ],
  "output": "selected"
}
