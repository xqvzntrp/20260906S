{
  "relation_id": "partner_product_readiness",
  "description": "Comparison of attributed product exposure against matching Expertise and commercial authorization evidence. Readiness is a derived classification and does not imply causation, compensation, or commercial-route ownership.",
  "inputs": {
    "exposure": "partner_product_booking_exposure",
    "expertise": "data/partner_expertise_evidence.csv",
    "authorization": "data/partner_commercial_authorizations.csv"
  },
  "steps": [
    {
      "id": "with_expertise",
      "op": "left_join",
      "left": "exposure",
      "right": "expertise",
      "on": [
        {
          "left": "partner_registry_id",
          "operator": "=",
          "right": "partner_registry_id"
        },
        {
          "left": "product_name",
          "operator": "=",
          "right": "product_name"
        }
      ]
    },
    {
      "id": "expertise_projection",
      "op": "project",
      "from": "with_expertise",
      "select": [
        "principal_partner_registry_id",
        "partner_registry_id",
        "partner_name",
        "membership_type",
        "attribution_type",
        "product_name",
        "expertise_evidence_id",
        "booking_exposure",
        "opportunity_count"
      ]
    },
    {
      "id": "with_authorization",
      "op": "left_join",
      "left": "expertise_projection",
      "right": "authorization",
      "on": [
        {
          "left": "partner_registry_id",
          "operator": "=",
          "right": "partner_registry_id"
        },
        {
          "left": "product_name",
          "operator": "=",
          "right": "product_name"
        }
      ]
    },
    {
      "id": "expertise_flag",
      "op": "derive",
      "from": "with_authorization",
      "columns": [
        {
          "name": "expertise_present",
          "expression": {
            "condition": {
              "column": "expertise_evidence_id",
              "operator": "is_not_null"
            },
            "then": {
              "value": "YES"
            },
            "else": {
              "value": "NO"
            }
          }
        }
      ]
    },
    {
      "id": "authorization_flag",
      "op": "derive",
      "from": "expertise_flag",
      "columns": [
        {
          "name": "authorization_present",
          "expression": {
            "condition": {
              "column": "authorization_id",
              "operator": "is_not_null"
            },
            "then": {
              "value": "YES"
            },
            "else": {
              "value": "NO"
            }
          }
        }
      ]
    },
    {
      "id": "readiness_state",
      "op": "derive",
      "from": "authorization_flag",
      "columns": [
        {
          "name": "readiness_state",
          "expression": {
            "condition": {
              "column": "expertise_present",
              "operator": "=",
              "value": "YES"
            },
            "then": {
              "condition": {
                "column": "authorization_present",
                "operator": "=",
                "value": "YES"
              },
              "then": {
                "value": "EXPERTISE_AND_AUTHORIZED"
              },
              "else": {
                "value": "EXPERTISE_ONLY"
              }
            },
            "else": {
              "condition": {
                "column": "authorization_present",
                "operator": "=",
                "value": "YES"
              },
              "then": {
                "value": "AUTHORIZED_ONLY"
              },
              "else": {
                "value": "ATTRIBUTED_ONLY"
              }
            }
          }
        }
      ]
    },
    {
      "id": "selected",
      "op": "project",
      "from": "readiness_state",
      "select": [
        "principal_partner_registry_id",
        "partner_registry_id",
        "partner_name",
        "membership_type",
        "attribution_type",
        "product_name",
        "expertise_present",
        "authorization_present",
        "readiness_state",
        "booking_exposure",
        "opportunity_count"
      ]
    }
  ],
  "output": "selected"
}
