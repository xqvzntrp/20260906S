{
  "relation_id": "marketplace_metering_summary",
  "description": "Monetary marketplace metering summarized by marketplace and product.",
  "inputs": {
    "usage_records": "data/marketplace_usage_records.csv",
    "entitlements": "data/marketplace_entitlements.csv",
    "offers": "data/marketplace_offers.csv",
    "products": "data/products.csv"
  },
  "steps": [
    {
      "id": "usage_with_entitlement",
      "op": "join",
      "left": "usage_records",
      "right": "entitlements",
      "on": [
        {
          "left": "entitlement_id",
          "operator": "=",
          "right": "entitlement_id"
        }
      ]
    },
    {
      "id": "usage_with_offer",
      "op": "join",
      "left": "usage_with_entitlement",
      "right": "offers",
      "on": [
        {
          "left": "offer_id",
          "operator": "=",
          "right": "offer_id"
        }
      ]
    },
    {
      "id": "usage_with_product",
      "op": "join",
      "left": "usage_with_offer",
      "right": "products",
      "on": [
        {
          "left": "product_id",
          "operator": "=",
          "right": "product_id"
        }
      ]
    },
    {
      "id": "summary",
      "op": "aggregate",
      "from": "usage_with_product",
      "group_by": [
        "marketplace",
        "product_name"
      ],
      "measures": [
        {
          "name": "reported_amount",
          "function": "SUM",
          "column": "reported_amount"
        },
        {
          "name": "usage_record_count",
          "function": "COUNT",
          "column": "usage_record_id"
        }
      ]
    }
  ],
  "output": "summary"
}
