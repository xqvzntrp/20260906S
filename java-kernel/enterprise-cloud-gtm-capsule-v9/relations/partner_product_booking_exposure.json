{
  "relation_id": "partner_product_booking_exposure",
  "description": "Opportunity attribution propagated to product bookings. Exposure is non-additive across partners.",
  "inputs": {
    "line_items": "data/opportunity_line_items.csv",
    "attribution": "data/opportunity_attribution.csv",
    "partners": "data/partners.csv",
    "products": "data/products.csv"
  },
  "steps": [
    {
      "id": "with_attribution",
      "op": "join",
      "left": "line_items",
      "right": "attribution",
      "on": [
        {
          "left": "opportunity_id",
          "operator": "=",
          "right": "opportunity_id"
        }
      ]
    },
    {
      "id": "with_partner",
      "op": "join",
      "left": "with_attribution",
      "right": "partners",
      "on": [
        {
          "left": "partner_registry_id",
          "operator": "=",
          "right": "partner_registry_id"
        }
      ]
    },
    {
      "id": "with_product",
      "op": "join",
      "left": "with_partner",
      "right": "products",
      "on": [
        {
          "left": "product_id",
          "operator": "=",
          "right": "product_id"
        }
      ]
    },
    {
      "id": "summary",
      "op": "aggregate",
      "from": "with_product",
      "group_by": [
        "principal_partner_registry_id",
        "partner_registry_id",
        "partner_name",
        "membership_type",
        "attribution_type",
        "product_name"
      ],
      "measures": [
        {
          "name": "booking_exposure",
          "function": "SUM",
          "column": "booking_amount"
        },
        {
          "name": "opportunity_count",
          "function": "COUNT_DISTINCT",
          "column": "opportunity_id"
        }
      ]
    }
  ],
  "output": "summary"
}
