{
  "relation_id": "product_commitments",
  "inputs": {
    "contract_lines": "data/contract_line_items.csv",
    "products": "data/products.csv"
  },
  "steps": [
    {
      "id": "enriched",
      "op": "join",
      "left": "contract_lines",
      "right": "products",
      "on": [
        {
          "left": "product_id",
          "operator": "=",
          "right": "product_id"
        }
      ]
    },
    {
      "id": "summary",
      "op": "aggregate",
      "from": "enriched",
      "group_by": [
        "product_name",
        "product_family"
      ],
      "measures": [
        {
          "name": "committed_quantity",
          "function": "SUM",
          "column": "committed_quantity"
        },
        {
          "name": "contract_count",
          "function": "COUNT_DISTINCT",
          "column": "contract_id"
        }
      ]
    }
  ],
  "output": "summary"
}
